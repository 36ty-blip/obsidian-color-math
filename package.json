{
  "name": "obsidian-color-math",
  "version": "1.0.128",
  "description": "AST-driven semantic syntax highlighting and real-time MathJax CHTML decoration for mathematical expressions in markdown notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "generate:constructors": "node scripts/generate_constructors.mjs",
    "build": "node scripts/generate_constructors.mjs && node esbuild.config.mjs production",
    "bench:build": "node esbuild.bench.mjs",
    "bench:sync": "node scripts/sync_benchmarks.mjs",
    "bench": "npm run bench:build && node --expose-gc dist/perf_runner.cjs && node scripts/sync_benchmarks.mjs",
    "visualize": "npx tsx scripts/visualize_dual_tree.ts",
    "profile:keystroke": "npx tsx scripts/keystroke_profiler.ts",
    "test": "node scripts/run_tests.mjs",
    "test:all": "node scripts/run_tests.mjs --all",
    "test:failed": "node scripts/run_tests.mjs --failed",
    "test:list": "node scripts/run_tests.mjs --list",
    "test:stage": "node scripts/run_tests.mjs --stage",
    "test:orchestrate": "node scripts/run_tests.mjs",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:corpus": "npx tsx tests/corpus_audit.ts",
    "bench:split": "npx tsx tests/corpus_split_audit.ts",
    "test:keystroke": "npx tsx tests/keystroke_prefix_audit.ts",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release:quick": "node scripts/release.mjs --quick",
    "publish:github": "node scripts/publish_github.mjs",
    "publish:dry": "node scripts/publish_github.mjs --dry-run",
    "release:stats": "node scripts/telemetry.mjs",
    "lint:obsidian": "eslint src/",
    "lint:advisory": "eslint src/ --config eslint.advisory.mjs"
  },
  "dependencies": {
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.26.3",
    "zod": "^4.6.4"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "mathjax",
    "latex",
    "color"
  ],
  "author": "36ty-blip",
  "license": "MIT",
  "devDependencies": {
    "@mathjax/src": "^4.1.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "esbuild": "0.20.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fast-check": "^3.18.0",
    "katex": "^0.19.1",
    "obsidian": "latest",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
